# Required for new paid LLM predictions. Offline analysis and prompt previews use no key.
OPENROUTER_API_KEY=
# Optional for --tokenizer auto with gated Hugging Face models.
HF_TOKEN=

# Local observer preview defaults. Use separate values per study when recruiting.
PROLIFIC_COMPLETION_CODE=LOCALPREVIEW
PROLIFIC_REQUIRED=0
PROLIFIC_STUDY_ID=

# Optional original actor application settings.
QUIZCOMP_API_BASE=http://127.0.0.1:8000
# WEBARENA_CONFIG=/absolute/path/to/your/local-webarena-config.json
# WEBARENA_STORAGE_STATE=/absolute/path/to/your/private/browser-state.json
# Use fresh, writable databases for new actor data collection.
# REALUSER_DB_PATH=/absolute/path/to/new-testreco.sqlite
# QUIZCOMP_DB_PATH=/absolute/path/to/new-quizcomp.sqlite
# QUIZCOMP_CODES_JSON=/absolute/path/to/private-completion-codes.json
# WEBARENA_DB=/absolute/path/to/new-webarena.sqlite
